<Window x:Class="mdk02.AddServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить услугу" Height="300" Width="400">
    <Grid>
        <StackPanel>
            <TextBlock Text="Название услуги" Margin="10"/>
            <TextBox x:Name="ServiceNameTextBox" Margin="10"/>

            <TextBlock Text="Описание" Margin="10"/>
            <TextBox x:Name="ServiceDescriptionTextBox" Margin="10"/>

            <TextBlock Text="Цена" Margin="10"/>
            <TextBox x:Name="ServiceCostTextBox" Margin="10"/>

            <Button Content="Сохранить" Margin="10" Click="SaveButton_Click"/>
            <Button Content="Отмена" Margin="10" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
