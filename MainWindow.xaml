<Window x:Class="mdk02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список услуг" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="ServicesDataGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                <DataGridTextColumn Header="Название услуги" Binding="{Binding Title}" Width="*"/>
                <DataGridTemplateColumn Header="Действия">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Просмотреть клиентов" Click="ViewClientsButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Добавить услугу" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="120" Margin="10"
                Click="AddServiceButton_Click"/>
        <Button Content="Удалить услугу" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="120" Margin="140,10,10,10"
                Click="DeleteServiceButton_Click"/>
        <Button Content="Сортировать по возрастанию" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="150" Margin="10"
                Click="SortAscButton_Click"/>
        <Button Content="Сортировать по убыванию" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="150" Margin="0,0,176,10"
                Click="SortDescButton_Click"/>
    </Grid>
</Window>
