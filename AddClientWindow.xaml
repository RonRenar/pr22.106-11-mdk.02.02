<Window x:Class="mdk02.AddClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить клиента" Height="350" Width="400">
    <Grid>
        <StackPanel>
            <TextBlock Text="Имя" Margin="10"/>
            <TextBox x:Name="FirstNameTextBox" Margin="10"/>

            <TextBlock Text="Фамилия" Margin="10"/>
            <TextBox x:Name="LastNameTextBox" Margin="10"/>

            <TextBlock Text="Отчество" Margin="10"/>
            <TextBox x:Name="PatronymicTextBox" Margin="10"/>

            <TextBlock Text="Дата рождения" Margin="10"/>
            <DatePicker x:Name="BirthdayDatePicker" Margin="10"/>

            <TextBlock Text="Пол" Margin="10"/>
            <ComboBox x:Name="GenderComboBox" Margin="10">
                <ComboBoxItem Content="М"/>
                <ComboBoxItem Content="Ж"/>
            </ComboBox>

            <TextBlock Text="Фото" Margin="10"/>
            <TextBox x:Name="PhotoPathTextBox" Margin="10"/>

            <Button Content="Сохранить" Margin="10" Click="SaveButton_Click"/>
            <Button Content="Отмена" Margin="10" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
